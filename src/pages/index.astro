---
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import WhyUs from '../components/WhyUs.astro';
import Portfolio from '../components/Portfolio.astro';
import Legalitas from '../components/Legalitas.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import { company } from '../data/company';
---

<Layout>
	<header class="w-full fixed top-0 z-50 backdrop-blur-xl bg-white/80 border-b border-stone-200/60">
		<div class="max-w-6xl mx-auto px-6 lg:px-8 h-[72px] flex items-center">
			<a href="#" class="flex items-center gap-2.5 mr-auto">
				<span class="text-xl font-extrabold tracking-tight text-ink">Chilva</span>
				<span class="text-xl font-light text-stone-400">Computer</span>
			</a>

			<div class="hidden md:flex items-center gap-8">
				<nav class="flex items-center gap-8 text-[15px] font-medium text-mute">
					<a href="#layanan" class="hover:text-ink transition-colors duration-200">Layanan</a>
					<a href="#tentang" class="hover:text-ink transition-colors duration-200">Tentang</a>
					<a href="#portofolio" class="hover:text-ink transition-colors duration-200">Portofolio</a>
					<a href="#kontak" class="hover:text-ink transition-colors duration-200">Kontak</a>
				</nav>
				<a
					href={company.hero.primaryUrl}
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-2 bg-ink text-white text-[15px] font-semibold px-6 py-2.5 rounded-full hover:bg-ink/90 transition-all duration-200">
					Konsultasi
				</a>
			</div>

			<button id="menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" class="md:hidden flex flex-col gap-1.5 p-2 ml-auto">
				<span id="menu-icon-open" class="block w-5 h-[1.5px] bg-ink rounded-full transition-all"></span>
				<span class="block w-5 h-[1.5px] bg-ink rounded-full transition-all"></span>
				<span id="menu-icon-close" class="hidden block w-5 h-[1.5px] bg-ink rounded-full rotate-45 translate-y-[4.5px] transition-all"></span>
			</button>
		</div>

		<div id="mobile-menu" class="hidden md:hidden border-t border-stone-200/60 bg-white/95 backdrop-blur-xl">
			<div class="max-w-6xl mx-auto px-6 py-6 flex flex-col gap-4">
				<a href="#layanan" class="text-[15px] font-medium text-mute hover:text-ink transition-colors">Layanan</a>
				<a href="#tentang" class="text-[15px] font-medium text-mute hover:text-ink transition-colors">Tentang</a>
				<a href="#portofolio" class="text-[15px] font-medium text-mute hover:text-ink transition-colors">Portofolio</a>
				<a href="#kontak" class="text-[15px] font-medium text-mute hover:text-ink transition-colors">Kontak</a>
				<a href={company.hero.primaryUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center justify-center bg-ink text-white text-[15px] font-semibold px-6 py-3 rounded-full hover:bg-ink/90 transition-all">Konsultasi</a>
			</div>
		</div>
	</header>

	<main>
		<!-- Hero -->
		<section class="w-full pt-[120px] pb-14 lg:pt-[130px] lg:pb-20">
			<div class="max-w-6xl mx-auto px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
					<!-- Left: Text -->
					<div>
						<h1 class="text-[clamp(2.5rem,5vw,4rem)] font-extrabold text-ink leading-[1.08] tracking-[-0.025em]">
							Mitra Terpercaya Pengadaan Hardware, CCTV & Jaringan
						</h1>
						<p class="mt-7 text-body-lg text-mute leading-relaxed">
							Solusi terpadu pengadaan barang IT, instalasi CCTV, dan optimasi jaringan — mulai dari konsultasi, pemasangan, hingga perawatan berkala untuk bisnis dan instansi Anda.
						</p>
						<div class="mt-10 flex flex-col sm:flex-row items-start gap-4">
							<a
								href={company.hero.primaryUrl}
								target="_blank"
								rel="noopener"
								class="inline-flex items-center justify-center gap-2 bg-ink text-white font-semibold text-[15px] px-8 py-3.5 rounded-full hover:bg-ink/90 transition-all duration-200">
								Konsultasi Gratis
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
							</a>
							<a
								href="#layanan"
								class="inline-flex items-center justify-center gap-2 text-mute font-semibold text-[15px] px-8 py-3.5 rounded-full border border-stone-200 hover:border-stone-300 hover:text-ink transition-all duration-200">
								Lihat Layanan
							</a>
						</div>
					</div>

					<!-- Right: Company Documentation Visual -->
					<div class="hidden lg:block lg:mt-0">
						<div>
							<!-- Main card -->
							<div class="bg-white rounded-3xl p-8 shadow-[0_1px_3px_rgba(0,0,0,0.04)] border border-stone-100">
								<div class="flex items-center gap-3 mb-6">
									<div class="w-10 h-10 rounded-full bg-ink flex items-center justify-center text-white text-[13px] font-bold">CV</div>
									<div>
										<p class="text-[15px] font-semibold text-ink">CV. Chilva Computer</p>
										<p class="text-[13px] text-stone-400">IT & Security Provider</p>
									</div>
								</div>

								<div class="space-y-4">
									<div class="flex items-center gap-3 p-3 rounded-xl bg-stone-50">
										<div class="w-8 h-8 rounded-lg bg-stone-200/60 flex items-center justify-center">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
										</div>
										<div>
											<p class="text-[13px] font-semibold text-ink">Pengadaan Hardware</p>
											<p class="text-[12px] text-stone-400">Server, Workstation, Networking</p>
										</div>
									</div>
									<div class="flex items-center gap-3 p-3 rounded-xl bg-stone-50">
										<div class="w-8 h-8 rounded-lg bg-stone-200/60 flex items-center justify-center">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
										</div>
										<div>
											<p class="text-[13px] font-semibold text-ink">Instalasi CCTV 24/7</p>
											<p class="text-[12px] text-stone-400">IP Camera, NVR, Monitoring</p>
										</div>
									</div>
									<div class="flex items-center gap-3 p-3 rounded-xl bg-stone-50">
										<div class="w-8 h-8 rounded-lg bg-stone-200/60 flex items-center justify-center">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
										</div>
										<div>
											<p class="text-[13px] font-semibold text-ink">Optimasi Jaringan</p>
											<p class="text-[12px] text-stone-400">LAN, Wi-Fi, Fiber Optic</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats -->
		<section class="border-y border-stone-200/60 bg-white">
			<div class="max-w-6xl mx-auto px-6 lg:px-8 py-12 lg:py-14 grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
				{
					company.stats.map((stat) => (
						<div class="text-center">
							<span class="block text-display text-ink">{stat.value}</span>
							<span class="mt-2 block text-utility-xs uppercase tracking-[0.15em] text-mute">{stat.label}</span>
						</div>
					))
				}
			</div>
		</section>

		<Services />
		<About />
		<WhyUs />
		<Portfolio />
		<Legalitas />
		<Testimonials />
		<Contact />

		<!-- CTA Band -->
		<section class="py-12 bg-slate-100/70 text-center">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
					Siap Meningkatkan Infrastruktur IT Anda?
				</h2>
				<p class="text-base sm:text-lg text-gray-600 leading-relaxed mb-8">
					Siap bantu dari konsultasi hingga pemasangan — tanpa biaya, tanpa komitmen.
				</p>
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<a
						href={company.whatsappUrl}
						target="_blank"
						rel="noopener"
						class="bg-gray-900 hover:bg-black text-white font-bold px-8 py-3.5 rounded-full transition-all shadow-md text-sm">
						Chat Langsung
					</a>
					<a
						href="#kontak"
						class="border border-gray-300 hover:bg-white text-gray-800 font-semibold px-8 py-3.5 rounded-full transition-all text-sm">
						Hubungi Kami
					</a>
				</div>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="bg-canvas border-t border-stone-200/60">
		<div class="max-w-6xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">
				<!-- Brand -->
				<div class="md:col-span-5">
					<div class="flex items-center gap-2.5">
						<span class="text-xl font-extrabold tracking-tight text-ink">Chilva</span>
						<span class="text-xl font-light text-stone-400">Computer</span>
					</div>
					<p class="mt-4 text-body-md text-mute leading-relaxed max-w-sm">
						{company.address}
					</p>
					<div class="mt-6 flex items-center gap-4">
						<a href={`mailto:${company.email}`} class="text-sm text-mute hover:text-ink transition-colors" aria-label="Email">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>
						</a>
						<a href={company.whatsappUrl} target="_blank" rel="noopener" class="text-sm text-mute hover:text-ink transition-colors" aria-label="WhatsApp">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						</a>
						<a href={company.mapUrl} target="_blank" rel="noopener" class="text-sm text-mute hover:text-ink transition-colors" aria-label="Lokasi">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
						</a>
					</div>
				</div>

				<!-- Links -->
				<div class="md:col-span-3">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.15em] text-ink mb-5">Navigasi</h3>
					<ul class="space-y-3 text-[15px]">
						<li><a href="#layanan" class="text-mute hover:text-ink transition-colors">Layanan</a></li>
						<li><a href="#tentang" class="text-mute hover:text-ink transition-colors">Tentang Kami</a></li>
						<li><a href="#portofolio" class="text-mute hover:text-ink transition-colors">Portofolio</a></li>
						<li><a href="#kontak" class="text-mute hover:text-ink transition-colors">Kontak</a></li>
					</ul>
				</div>

				<!-- Services -->
				<div class="md:col-span-2">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.15em] text-ink mb-5">Layanan</h3>
					<ul class="space-y-3 text-[15px]">
						<li><a href="#layanan" class="text-mute hover:text-ink transition-colors">Jaringan & FTTH</a></li>
						<li><a href="#layanan" class="text-mute hover:text-ink transition-colors">CCTV Enterprise</a></li>
						<li><a href="#layanan" class="text-mute hover:text-ink transition-colors">Server & Data Center</a></li>
					</ul>
				</div>

				<!-- Contact -->
				<div class="md:col-span-2">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.15em] text-ink mb-5">Kontak</h3>
					<ul class="space-y-3 text-[15px] text-mute">
						<li>{company.phoneDisplay}</li>
						<li class="break-all"><a href={`mailto:${company.email}`} class="hover:text-ink transition-colors">{company.email}</a></li>
						<li>{company.hours}</li>
					</ul>
				</div>
			</div>

			<!-- Bottom -->
			<div class="mt-10 pt-6 border-t border-stone-200/60 flex flex-col sm:flex-row items-center justify-between text-[13px] text-stone-400">
				<p>&copy; 2026 CV Chilva Computer. All rights reserved.</p>
				<p class="mt-2 sm:mt-0">{company.legal.domicile}</p>
			</div>
		</div>
	</footer>

	<!-- Back to top -->
	<button
		id="back-to-top"
		type="button"
		aria-label="Kembali ke atas"
		class="fixed right-5 bottom-5 z-50 hidden h-11 w-11 items-center justify-center rounded-full bg-white border border-stone-200 text-ink shadow-sm transition-all duration-200 hover:shadow-md">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none"
			stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
			><path d="M12 19V5" /><path d="m5 12 7-7 7 7" /></svg
		>
	</button>

	<script>
		const toggle = document.getElementById('menu-toggle');
		const menu = document.getElementById('mobile-menu');
		const openIcon = document.getElementById('menu-icon-open');
		const closeIcon = document.getElementById('menu-icon-close');

		function setMenu(open) {
			menu.classList.toggle('hidden', !open);
			openIcon.classList.toggle('hidden', open);
			closeIcon.classList.toggle('hidden', !open);
			toggle.setAttribute('aria-expanded', String(open));
		}

		toggle.addEventListener('click', () => {
			setMenu(menu.classList.contains('hidden'));
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenu(false));
		});

		const sections = ['beranda', 'layanan', 'tentang', 'portofolio', 'kontak']
			.map((id) => document.getElementById(id))
			.filter(Boolean);
		const navAnchors = [
			...document.querySelectorAll('header nav a'),
			...document.querySelectorAll('#mobile-menu a'),
		];

		function syncActiveSection() {
			const pos = window.scrollY + 100;
			let current = 'beranda';
			for (const section of sections) {
				if (section.offsetTop <= pos) current = section.id;
			}
			navAnchors.forEach((anchor) => {
				const href = anchor.getAttribute('href');
				const active = href === `#${current}`;
				anchor.classList.toggle('text-ink', active);
				anchor.classList.toggle('text-mute', !active);
			});
		}

		const backToTop = document.getElementById('back-to-top');
		function syncBackToTop() {
			backToTop.classList.toggle('hidden', window.scrollY < 600);
		}

		window.addEventListener('scroll', () => {
			syncActiveSection();
			syncBackToTop();
		});
		syncActiveSection();
		syncBackToTop();

		backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

		const revealEls = document.querySelectorAll('.js-reveal');
		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							const el = entry.target;
							el.classList.add('is-visible');
							observer.unobserve(el);
							const settle = () => {
								el.classList.remove('js-reveal');
								el.style.transitionDelay = '';
							};
							el.addEventListener('transitionend', settle, { once: true });
							setTimeout(() => {
								if (el.classList.contains('js-reveal')) settle();
							}, 1500);
						}
					}
				},
				{ threshold: 0.1 }
			);
			let revealIndex = 0;
			revealEls.forEach((el) => {
				el.style.transitionDelay = `${(revealIndex % 6) * 80}ms`;
				revealIndex += 1;
				observer.observe(el);
			});
		} else {
			revealEls.forEach((el) => el.classList.remove('js-reveal'));
		}
	</script>
</Layout>
