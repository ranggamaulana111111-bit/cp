---
import { company } from '../data/company';
---

<section id="testimoni" class="bg-canvas border-t border-hairline">
	<div class="mx-auto max-w-[1440px] px-8 py-section">
		<!-- Header -->
		<div class="mx-auto max-w-3xl">
			<p class="text-caption-md text-mute uppercase tracking-wider">Testimoni Klien</p>
			<h2 class="mt-3 text-heading-xl text-ink uppercase">
				APA KATA MEREKA TENTANG KAMI
			</h2>
			<p class="mt-4 max-w-2xl text-body-md text-charcoal">
				Kepercayaan dan kepuasan klien adalah ukuran utama keberhasilan kami.
			</p>
		</div>

		<!-- Cards -->
		<div class="mt-section grid gap-4 md:grid-cols-2 lg:grid-cols-3">
			{
				company.testimonials.map((testimonial) => (
					<figure class="js-reveal relative flex flex-col bg-soft-cloud p-6">
						<div class="flex gap-1 text-ink" aria-label="Rating 5 dari 5">
							{
								Array.from({ length: 5 }).map(() => (
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4"
										viewBox="0 0 24 24" fill="currentColor"
										><path
											d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg
									>
								))
							}
						</div>
						<blockquote class="mt-4 flex-1">
							<p class="text-body-md text-charcoal leading-relaxed">"{testimonial.quote}"</p>
						</blockquote>
						<figcaption class="mt-6 flex items-center gap-3 border-t border-hairline pt-5">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink text-canvas text-caption-sm font-medium">
								{testimonial.name.replace(/[^A-Za-z ]/g, '').split(' ').filter((w) => w).slice(0, 2).map((w) => w[0]).join('')}
							</span>
							<div class="min-w-0">
								<p class="truncate text-body-strong text-ink">{testimonial.name}</p>
								<p class="truncate text-caption-md text-mute">
									{testimonial.role} — {testimonial.company}
								</p>
							</div>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
