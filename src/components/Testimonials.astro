---
import { company } from '../data/company';
---

<section id="testimoni" class="bg-stone-warm/20 py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="text-center mb-12 lg:mb-16">
			<p class="text-meta text-teal mb-4">TESTIMONI</p>
			<h2 class="text-display-sm text-ink">Kata Klien Kami</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
			{company.testimonials.map((testimonial) => (
				<figure class="js-reveal flex flex-col">
					<blockquote class="flex-1">
						<p class="text-body-lg text-ink leading-relaxed">"{testimonial.quote}"</p>
					</blockquote>
					<figcaption class="mt-8 pt-6 border-t border-border">
						<div class="flex items-center gap-3">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-ink text-white text-[12px] font-semibold">
								{testimonial.name.replace(/[^A-Za-z ]/g, '').split(' ').filter((w) => w).slice(0, 2).map((w) => w[0]).join('')}
							</span>
							<div class="min-w-0">
								<p class="text-[14px] font-semibold text-ink">{testimonial.name}</p>
								<p class="text-[13px] text-mute">{testimonial.role} — {testimonial.company}</p>
							</div>
						</div>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
