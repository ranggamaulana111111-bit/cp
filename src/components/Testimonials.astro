---
import { company } from '../data/company';
---

<section id="testimoni" class="bg-soft-cloud py-14 lg:py-20">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-utility-xs uppercase tracking-[0.2em] text-mute mb-4">Testimoni Klien</p>
			<h2 class="text-heading-xl text-ink">Apa Kata Mereka<br />Tentang Kami</h2>
		</div>

		<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
			{
				company.testimonials.map((testimonial) => (
					<figure class="js-reveal flex flex-col">
						<svg class="h-8 w-8 text-stone-300 mb-4" viewBox="0 0 24 24" fill="currentColor"><path d="M11.3 5.2C7.6 7.1 5.5 10.5 5.5 14.4c0 2.4 1.2 4.2 3.2 4.2 1.7 0 3-1.3 3-3 0-1.4-1-2.6-2.4-2.9.3-2.6 2-4.8 4.2-6.1L11.3 5.2zm8 0C15.6 7.1 13.5 10.5 13.5 14.4c0 2.4 1.2 4.2 3.2 4.2 1.7 0 3-1.3 3-3 0-1.4-1-2.6-2.4-2.9.3-2.6 2-4.8 4.2-6.1L19.3 5.2z"/></svg>
						<blockquote class="flex-1">
							<p class="text-body-lg text-charcoal leading-relaxed">{testimonial.quote}</p>
						</blockquote>
						<figcaption class="mt-6 flex items-center gap-3">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink text-white text-[13px] font-medium">
								{testimonial.name.replace(/[^A-Za-z ]/g, '').split(' ').filter((w) => w).slice(0, 2).map((w) => w[0]).join('')}
							</span>
							<div class="min-w-0">
								<p class="text-[14px] font-semibold text-ink">{testimonial.name}</p>
								<p class="text-[13px] text-mute">{testimonial.role} — {testimonial.company}</p>
							</div>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
