---
import { company } from '../data/company';
---

<section id="tentang" class="bg-canvas py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
			<!-- Left column -->
			<div class="lg:col-span-5">
				<p class="text-meta text-teal mb-4">TENTANG</p>
				<h2 class="text-display-sm text-ink whitespace-pre-line">{company.about.headline}</h2>

				<div class="mt-8">
					{company.about.paragraphs.map((p) => (
						<p class="text-body-lg text-mute leading-relaxed mb-4">{p}</p>
					))}
				</div>

				<!-- Values -->
				<div class="mt-10">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-ink mb-5">Nilai Inti</h3>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						{company.about.values.map((val) => (
							<div class="py-4 border-b border-border-soft">
								<h4 class="text-[15px] font-semibold text-ink">{val.title}</h4>
								<p class="mt-1 text-[13px] text-mute leading-relaxed">{val.desc}</p>
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Right column -->
			<div class="lg:col-span-7">
				<!-- Vision -->
				<div class="bg-stone-warm/30 rounded-lg p-8 lg:p-10">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-state mb-4">Visi</h3>
					<p class="text-[18px] font-medium text-ink leading-relaxed italic">"{company.about.visi}"</p>
				</div>

				<!-- Mission -->
				<div class="mt-8">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-ink mb-5">Misi</h3>
					<div class="space-y-0 divide-y divide-border">
						{company.about.misi.map((item, i) => (
							<div class="py-4 flex items-start gap-4">
								<span class="text-[12px] font-semibold text-state tabular-nums mt-0.5">{String(i + 1).padStart(2, '0')}</span>
								<p class="text-[15px] text-mute leading-relaxed">{item}</p>
							</div>
						))}
					</div>
				</div>

				<!-- History timeline -->
				<div class="mt-10">
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-ink mb-5">Linimasa</h3>
					<div class="space-y-0">
						{company.history.map((item) => (
							<div class="flex items-start gap-5 py-4 border-b border-border-soft last:border-0">
								<span class="text-[13px] font-semibold text-teal tabular-nums shrink-0 w-12">{item.year}</span>
								<div>
									<h4 class="text-[15px] font-semibold text-ink">{item.title}</h4>
									<p class="mt-1 text-[13px] text-mute leading-relaxed">{item.desc}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
