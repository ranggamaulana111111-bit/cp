---
import { company } from '../data/company';

const iconMap: Record<string, string> = {
	'Pengadaan Hardware': 'server',
	'Instalasi CCTV 24/7': 'camera',
	'Optimasi Jaringan Internet': 'network',
};
---

<section id="layanan" class="bg-canvas pt-16 pb-14 lg:pt-24 lg:pb-20">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-utility-xs uppercase tracking-[0.2em] text-mute mb-4">Layanan Kami</p>
			<h2 class="text-heading-xl text-ink">Solusi Teknologi<br />Terlengkap untuk Bisnis</h2>
		</div>

		<div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-0 divide-y md:divide-y-0 md:divide-x divide-stone-200/60">
			{
				company.services.map((service) => (
					<article class="group py-10 md:py-0 md:px-10 first:pt-0 md:first:pl-0 last:pb-0 md:last:pr-0 md:first:px-0 md:last:px-0 md:px-10">
						<div class="w-10 h-10 rounded-xl bg-stone-100 flex items-center justify-center mb-5">
							{iconMap[service.name] === 'network' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
							)}
							{iconMap[service.name] === 'camera' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
							)}
							{iconMap[service.name] === 'server' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
							)}
						</div>
						<h3 class="text-heading-md text-ink">{service.name}</h3>
						<p class="mt-3 text-body-md text-mute leading-relaxed">{service.description}</p>
						<a href="#kontak" class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-semibold text-ink group-hover:gap-2.5 transition-all duration-200">
							Pelajari Selengkapnya
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
