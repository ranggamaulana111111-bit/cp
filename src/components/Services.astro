---
import { company } from '../data/company';
---

<section id="layanan" class="bg-canvas py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
			<div class="lg:col-span-4">
				<p class="text-meta text-teal mb-4">LAYANAN</p>
				<h2 class="js-accent-line text-display-sm text-ink pb-2">Yang Kami Kerjakan</h2>
				<p class="mt-5 text-body-lg text-mute leading-relaxed max-w-sm">
					Infrastruktur yang menjaga bisnis Anda tetap terhubung, aman, dan berjalan.
				</p>
			</div>

			<div class="lg:col-span-8">
				<div class="divide-y divide-border">
					{company.services.map((service, idx) => (
						<article class="service-item group py-7 flex items-start justify-between gap-6 cursor-default">
							<div class="flex items-start gap-5 flex-1 min-w-0">
								<span class:list={[
									'service-num text-[13px] font-bold mt-1 transition-colors duration-200 tabular-nums',
									idx % 3 === 0 && 'text-teal',
									idx % 3 === 1 && 'text-rose',
									idx % 3 === 2 && 'text-sand',
								]}>{service.id}</span>
								<div class="flex-1 min-w-0">
									<h3 class="text-[18px] font-semibold text-ink service-name transition-colors duration-200">{service.name}</h3>
									<p class="mt-2 text-[14px] text-mute leading-relaxed">{service.shortDesc}</p>
									<div class="mt-3 overflow-hidden">
										<p class="text-[13px] text-state leading-relaxed max-h-0 group-hover:max-h-20 transition-all duration-500 ease-out opacity-0 group-hover:opacity-100">
											{service.description}
										</p>
									</div>
								</div>
							</div>
							<svg class="service-arrow h-4 w-4 text-state mt-1.5 shrink-0 transition-all duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</article>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
