---
import { company } from '../data/company';

const categories = [
	{
		name: 'Pengadaan Perangkat Keras',
		items: ['Server', 'PC Desktop', 'Laptop', 'Printer', 'Sparepart IT'],
		icon: 'hardware',
	},
	{
		name: 'Perangkat Jaringan',
		items: ['Router Enterprise', 'Managed Switch', 'Access Point', 'Kabel UTP/FO'],
		icon: 'network',
	},
	{
		name: 'Sistem Keamanan',
		items: ['Paket Kamera CCTV (IP & Analog)', 'NVR', 'DVR', 'Access Control'],
		icon: 'camera',
	},
	{
		name: 'Jasa Instalasi & Maintenance',
		items: ['Jasa penarikan kabel', 'Konfigurasi sistem', 'Kontrak perawatan'],
		icon: 'tools',
	},
];

const steps = [
	{
		title: 'Pengajuan Rencana / RAB',
		desc: 'Kirimkan kebutuhan spesifikasi barang atau jasa yang ingin Anda pengadaan.',
	},
	{
		title: 'Penawaran Harga Resmi',
		desc: 'Kami sampaikan surat penawaran harga sesuai budget dengan legalitas CV resmi.',
	},
	{
		title: 'Pengadaan & Pengerjaan',
		desc: 'Pengiriman barang berkualitas disertai instalasi oleh teknisi ahli.',
	},
	{
		title: 'Serah Terima & Garansi',
		desc: 'Dukungan purna jual lengkap, mulai dari garansi hingga kontrak maintenance.',
	},
];

const rfqMessage =
	'Halo CV. Chilva Computer, saya ingin meminta Surat Penawaran Harga (RFQ/RAB) untuk pengadaan barang/jasa IT. Mohon info lebih lanjut. Terima kasih.';
const rfqUrl = `https://wa.me/${company.whatsappNumber}?text=${encodeURIComponent(rfqMessage)}`;
---

<section id="layanan" class="bg-canvas border-t border-hairline">
	<div class="mx-auto max-w-[1440px] px-8 py-section">
		<!-- Header -->
		<div class="mx-auto max-w-3xl">
			<p class="text-caption-md text-mute uppercase tracking-wider">KBLI Teregistrasi & Vendor Resmi</p>
			<h2 class="mt-3 text-heading-xl text-ink uppercase">
				SOLUSI PENGADAAN BARANG & JASA IT TERPERCAYA
			</h2>
			<p class="mt-4 max-w-2xl text-body-md text-charcoal">
				CV. Chilva Computer siap melayani kebutuhan pengadaan perangkat keras, jaringan, dan sistem
				keamanan untuk kantor, sekolah, hingga instansi — dengan legalitas CV resmi dan dukungan teknis yang andal.
			</p>
		</div>

		<!-- KBLI Categories -->
		<div class="mt-section grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{
				company.kbliCategories.map((cat) => (
					<div class="js-reveal bg-soft-cloud p-6">
						<span class="inline-flex items-center text-caption-sm text-mute uppercase tracking-wider">
							{cat.code}
						</span>
						<h3 class="mt-3 text-body-strong text-ink">{cat.title}</h3>
						<p class="mt-2 text-body-md text-charcoal">{cat.desc}</p>
					</div>
				))
			}
		</div>

		<!-- Service Cards -->
		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{
				categories.map((category) => (
					<div class="js-reveal bg-soft-cloud p-6">
						<span class="flex h-10 w-10 items-center justify-center rounded-full bg-ink text-canvas">
							{category.icon === 'hardware' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
							)}
							{category.icon === 'network' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="14" width="20" height="7" rx="2" /><circle cx="6.5" cy="17.5" r="0.5" fill="currentColor" /><circle cx="12" cy="17.5" r="0.5" fill="currentColor" /><circle cx="17.5" cy="17.5" r="0.5" fill="currentColor" /><path d="M6 14v-2a6 6 0 0 1 12 0v2" /></svg>
							)}
							{category.icon === 'camera' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-3l-2.5-3Z" /><circle cx="12" cy="13" r="3" /></svg>
							)}
							{category.icon === 'tools' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
							)}
						</span>
						<h3 class="mt-4 text-body-strong text-ink">{category.name}</h3>
						<ul class="mt-3 space-y-1.5 text-body-md text-charcoal">
							{category.items.map((item) => (
								<li class="flex items-center gap-2">
									<span class="h-1 w-1 shrink-0 rounded-full bg-ink"></span>
									{item}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<!-- Alur Kerja -->
		<div class="mt-section">
			<h2 class="text-heading-xl text-ink uppercase text-center">
				ALUR KERJA PENGADAAN
			</h2>
			<p class="mx-auto mt-3 max-w-2xl text-center text-body-md text-mute">
				Proses yang transparan dan terstruktur, dari pengajuan hingga serah terima.
			</p>

			<div class="mt-section grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					steps.map((step, i) => (
						<div class="js-reveal bg-soft-cloud p-6">
							<span class="text-heading-lg text-ink">
								0{i + 1}
							</span>
							<h4 class="mt-3 text-body-strong text-ink">{step.title}</h4>
							<p class="mt-2 text-body-md text-charcoal">{step.desc}</p>
						</div>
					))
				}
			</div>
		</div>

		<!-- CTA B2B -->
		<div class="mt-section bg-soft-cloud p-8 sm:p-10">
			<div class="flex flex-col items-center gap-8 text-center lg:flex-row lg:justify-between lg:text-left">
				<div class="max-w-2xl">
					<h3 class="text-heading-lg text-ink uppercase">
						Butuh Surat Penawaran Harga (RAB) untuk Kantor Anda?
					</h3>
					<p class="mt-3 text-body-md text-charcoal">
						Kirimkan kebutuhan Anda dan dapatkan penawaran resmi dari CV. Chilva Computer.
					</p>
				</div>
				<a
					href={rfqUrl}
					target="_blank"
					rel="noopener"
					class="inline-flex h-12 shrink-0 items-center gap-2 rounded-full bg-ink px-8 text-button-md text-canvas transition-opacity hover:opacity-80">
					Minta Penawaran Harga (RFQ)
				</a>
			</div>
		</div>
	</div>
</section>
