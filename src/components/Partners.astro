---
import { company } from '../data/company';

const categories = [
	{ key: 'networking', label: 'Jaringan' },
	{ key: 'cctv', label: 'CCTV' },
	{ key: 'server', label: 'Server' },
	{ key: 'storage', label: 'Penyimpanan' },
	{ key: 'computer', label: 'Komputer' },
	{ key: 'fiber', label: 'Fiber Optik' },
];
---

<section class="bg-white py-16 lg:py-20 border-y border-border">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="text-center mb-10">
			<p class="text-meta text-state mb-3">MITRA TEKNOLOGI</p>
			<h2 class="text-heading-lg text-ink">Merek Resmi yang Kami Gunakan</h2>
		</div>

		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-8 items-start">
			{categories.map((cat) => {
				const brands = company.partners[cat.key as keyof typeof company.partners];
				return (
					<div class="text-center">
						<p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-state mb-4">{cat.label}</p>
						<div class="space-y-2">
							{brands.map((brand) => (
								<p class="text-[14px] font-medium text-ink">{brand}</p>
							))}
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>
