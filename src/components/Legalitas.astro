---
import { company } from '../data/company';
---

<section id="legalitas" class="bg-canvas py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
			<!-- Left -->
			<div class="lg:col-span-5">
				<p class="text-meta text-teal mb-4">LEGALITAS</p>
				<h2 class="text-display-sm text-ink">Dibangun atas Kepercayaan.</h2>
				<p class="mt-5 text-body-lg text-mute leading-relaxed">
					CV. Chilva Computer adalah badan usaha berbadan hukum resmi — aman untuk pengadaan instansi, tender pemerintah, dan kemitraan korporat.
				</p>

				<!-- Company info -->
				<div class="mt-8 p-6 bg-stone-warm/30 rounded-lg">
					<h3 class="text-[18px] font-bold text-ink">{company.legalName}</h3>
					<p class="mt-1 text-[14px] text-mute">{company.legal.type}</p>
					<div class="mt-5 pt-5 border-t border-border-soft space-y-3">
						<div>
							<p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-state">Direktur</p>
							<p class="mt-1 text-[14px] font-semibold text-ink">{company.legal.director}</p>
						</div>
						<div>
							<p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-state">Komisaris</p>
							<p class="mt-1 text-[14px] font-semibold text-ink">{company.legal.commissioner}</p>
						</div>
					</div>
				</div>

				<a
					href="#kontak"
					class="mt-6 inline-flex items-center gap-2 text-[13px] font-semibold text-ink">
					Lihat Kredensial Perusahaan
					<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>

			<!-- Right -->
			<div class="lg:col-span-7">
				<!-- Deeds -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
					<div class="bg-white p-6 rounded-lg border border-border-soft">
						<h4 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-state mb-3">Akta Pendirian</h4>
						<p class="text-[14px] text-ink leading-relaxed">{company.legal.deedEstablishment}</p>
					</div>
					<div class="bg-white p-6 rounded-lg border border-border-soft">
						<h4 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-state mb-3">Akta Perubahan</h4>
						<p class="text-[14px] text-ink leading-relaxed">{company.legal.deedAmendment}</p>
					</div>
				</div>

				<!-- KBLI -->
				<div>
					<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-ink mb-5">Klasifikasi KBLI</h3>
					<p class="text-[14px] text-mute leading-relaxed mb-6 max-w-lg">
						12 kategori KBLI terdaftar yang mencakup pengadaan IT, instalasi, konsultasi, dan layanan keamanan.
					</p>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						{company.kbliCategories.map((kbli) => (
							<div class="flex items-start gap-3 py-3 border-b border-border-soft">
								<span class="text-[11px] font-semibold text-teal tabular-nums shrink-0 w-20 mt-0.5">{kbli.code}</span>
								<p class="text-[13px] font-medium text-ink leading-snug">{kbli.title}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
