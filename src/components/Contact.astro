---
import { company } from '../data/company';

const contactItems = [
	{
		label: 'WhatsApp',
		value: company.phoneDisplay,
		href: company.whatsappUrl,
		external: true,
	},
	{
		label: 'Email',
		value: company.email,
		href: `mailto:${company.email}`,
		external: false,
	},
	{
		label: 'Alamat',
		value: company.address,
		href: company.mapUrl,
		external: true,
	},
	{
		label: 'Jam Operasional',
		value: company.hours,
		href: undefined,
		external: false,
	},
];

const rfqMessage =
	'Halo CV. Chilva Computer, saya ingin berkonsultasi mengenai kebutuhan IT dan keamanan perusahaan saya. Mohon informasinya. Terima kasih.';
const rfqUrl = `https://wa.me/${company.whatsappNumber}?text=${encodeURIComponent(rfqMessage)}`;
---

<section id="kontak" class="bg-near-black py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<!-- CTA Headline -->
		<div class="text-center mb-16">
			<p class="text-meta text-teal mb-6">HUBUNGI KAMI</p>
			<h2 class="text-display text-white whitespace-pre-line">{company.contact.headline}</h2>
			<p class="mt-6 text-body-xl text-white/50 leading-relaxed max-w-lg mx-auto">
				{company.contact.subtext}
			</p>
			<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a
					href={company.hero.primaryUrl}
					target="_blank"
					rel="noopener"
					class="btn-primary text-[15px] px-8 py-3.5 rounded-md inline-flex items-center gap-2">
					Mulai Konsultasi
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
				<a
					href={rfqUrl}
					target="_blank"
					rel="noopener"
					class="text-[15px] font-semibold text-white/70 hover:text-white px-8 py-3.5 rounded-md border border-white/15 hover:border-white/30 transition-all duration-200 inline-flex items-center gap-2">
					WhatsApp Kami
				</a>
			</div>
		</div>

		<!-- Contact Grid -->
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mb-16">
			{contactItems.map((item) => (
				<div>
					<p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-white/40 mb-2">{item.label}</p>
					{item.href ? (
						<a
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener' : undefined}
							class="text-[14px] font-medium text-white hover:text-teal transition-colors leading-relaxed break-words">
							{item.value}
						</a>
					) : (
						<p class="text-[14px] font-medium text-white leading-relaxed break-words">{item.value}</p>
					)}
				</div>
			))}
		</div>

		<!-- Form -->
		<div class="max-w-2xl mx-auto">
			<h3 class="text-[13px] font-semibold uppercase tracking-[0.12em] text-white/40 mb-6">Kirim Kebutuhan Anda</h3>
			<form id="contact-form" data-wa={company.whatsappNumber} class="space-y-5">
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="block">
						<span class="mb-2 block text-[12px] font-medium text-white/40">Nama</span>
						<input
							type="text"
							id="form-name"
							required
							placeholder="Nama Anda"
							class="w-full border-b border-white/20 bg-transparent px-0 py-3 text-[15px] text-white placeholder:text-white/25 focus:border-teal focus:outline-none transition-colors"
						/>
					</label>
					<label class="block">
						<span class="mb-2 block text-[12px] font-medium text-white/40">Perusahaan / Instansi</span>
						<input
							type="text"
							id="form-company"
							placeholder="Nama perusahaan"
							class="w-full border-b border-white/20 bg-transparent px-0 py-3 text-[15px] text-white placeholder:text-white/25 focus:border-teal focus:outline-none transition-colors"
						/>
					</label>
				</div>
				<label class="block">
					<span class="mb-2 block text-[12px] font-medium text-white/40">No. WhatsApp</span>
					<input
						type="tel"
						id="form-phone"
						required
						placeholder="08xx-xxxx-xxxx"
						class="w-full border-b border-white/20 bg-transparent px-0 py-3 text-[15px] text-white placeholder:text-white/25 focus:border-teal focus:outline-none transition-colors"
					/>
				</label>
				<label class="block">
					<span class="mb-2 block text-[12px] font-medium text-white/40">Jenis Proyek</span>
					<select
						id="form-type"
						class="w-full border-b border-white/20 bg-transparent px-0 py-3 text-[15px] text-white focus:border-teal focus:outline-none transition-colors appearance-none cursor-pointer">
						<option value="" class="bg-near-black">Pilih jenis...</option>
						<option value="CCTV" class="bg-near-black">CCTV & Keamanan</option>
						<option value="Network" class="bg-near-black">Jaringan & Fiber</option>
						<option value="Server" class="bg-near-black">Server & Data Center</option>
						<option value="Procurement" class="bg-near-black">Pengadaan IT</option>
						<option value="Maintenance" class="bg-near-black">Dukungan Terkelola</option>
						<option value="Other" class="bg-near-black">Lainnya</option>
					</select>
				</label>
				<label class="block">
					<span class="mb-2 block text-[12px] font-medium text-white/40">Kebutuhan</span>
					<textarea
						id="form-message"
						required
						rows="4"
						placeholder="Jelaskan kebutuhan proyek Anda..."
						class="w-full resize-none border-b border-white/20 bg-transparent px-0 py-3 text-[15px] text-white placeholder:text-white/25 focus:border-teal focus:outline-none transition-colors"
					></textarea>
				</label>
				<div class="pt-4">
					<button
						type="submit"
						class="btn-primary text-[15px] px-8 py-3.5 rounded-md inline-flex items-center gap-2">
						Kirim via WhatsApp
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
					</button>
					<p class="mt-3 text-[13px] text-white/30">
						Klik kirim untuk melanjutkan ke WhatsApp.
					</p>
				</div>
			</form>
		</div>
	</div>

	<script>
		const form = document.getElementById('contact-form');
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const name = document.getElementById('form-name').value.trim();
			const company = document.getElementById('form-company').value.trim();
			const phone = document.getElementById('form-phone').value.trim();
			const type = document.getElementById('form-type').value;
			const message = document.getElementById('form-message').value.trim();

			const lines = [
				'Halo CV. Chilva Computer, saya ingin mengajukan kebutuhan berikut:',
				'',
				`Nama: ${name}`,
				company ? `Perusahaan/Instansi: ${company}` : '',
				`No. WhatsApp: ${phone}`,
				type ? `Jenis Proyek: ${type}` : '',
				'',
				'Kebutuhan:',
				message,
			].filter(Boolean);

			const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
			window.open(url, '_blank', 'noopener');
		});
	</script>
</section>
