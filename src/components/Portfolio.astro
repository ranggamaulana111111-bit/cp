---
import { company } from '../data/company';
---

<section id="portofolio" class="bg-canvas py-14 lg:py-20 border-t border-stone-200/60">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-utility-xs uppercase tracking-[0.2em] text-mute mb-4">Portofolio</p>
			<h2 class="text-heading-xl text-ink">Proyek yang Telah<br />Kami Kerjakan</h2>
			<p class="mt-5 text-body-lg text-mute leading-relaxed">
				Sebagian proyek pengerjaan pengadaan, jaringan, dan keamanan yang telah kami selesaikan.
			</p>
		</div>

		<div class="mt-10 space-y-0 divide-y divide-stone-200/60">
			{
				company.portfolio.map((project) => (
					<article class="group js-reveal py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors">
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-3 mb-2">
								<span class="text-[13px] font-medium text-stone-400 uppercase tracking-wider">{project.category}</span>
							</div>
							<h3 class="text-body-strong text-ink group-hover:underline underline-offset-4">{project.title}</h3>
							<p class="mt-1.5 text-body-md text-mute">{project.desc}</p>
						</div>
						<div class="flex items-center gap-1.5 shrink-0">
							{project.tags.map((tag) => (
								<span class="inline-block text-[12px] font-medium text-stone-400 bg-stone-100 px-2.5 py-1 rounded-full">{tag}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
