---
const reasons = [
	{
		title: 'Garansi Resmi',
		desc: 'Semua produk bergaransi resmi dari distributor terpercaya, bukan barang gray market.',
	},
	{
		title: 'Tim Bersertifikat',
		desc: 'Teknisi dengan sertifikasi resmi dan pengalaman lapangan yang luas di bidang IT & keamanan.',
	},
	{
		title: 'Purna Jual Andal',
		desc: 'Dukungan teknis, maintenance berkala, dan SLA yang jelas untuk ketenangan operasional Anda.',
	},
	{
		title: 'Legalitas Jelas',
		desc: 'Perusahaan berbadan hukum CV dengan akta notaris — aman untuk kontrak pengadaan instansi.',
	},
];
---

<section id="keunggulan" class="bg-canvas py-14 lg:py-20 border-t border-stone-200/60">
	<div class="max-w-6xl mx-auto px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-utility-xs uppercase tracking-[0.2em] text-mute mb-4">Keunggulan Kami</p>
		<h2 class="text-heading-xl text-ink">Mengapa Memilih<br />CV Chilva Computer?</h2>
		<p class="mt-5 text-body-lg text-mute leading-relaxed">
			Kami menggabungkan pengadaan perangkat berkualitas, instalasi profesional, dan dukungan berkelanjutan dalam satu layanan terintegrasi — berpusat di Serang, Banten.
		</p>
		</div>

		<div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
			{
				reasons.map((item) => (
					<div class="flex items-start gap-4 p-6 rounded-2xl bg-stone-50 border border-stone-100">
						<div class="flex-shrink-0 w-8 h-8 rounded-full bg-ink flex items-center justify-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						</div>
						<div>
							<h3 class="text-[15px] font-semibold text-ink">{item.title}</h3>
							<p class="mt-1.5 text-[14px] text-mute leading-relaxed">{item.desc}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
