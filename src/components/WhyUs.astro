---
const reasons = [
	{
		num: '01',
		title: 'Badan Hukum Resmi',
		desc: 'Terdaftar sebagai CV dengan akta notaris — aman untuk kontrak pengadaan instansi dan tender pemerintah.',
	},
	{
		num: '02',
		title: 'Teknisi Bersertifikat',
		desc: 'Teknisi lapangan dengan sertifikasi relevan dan pengalaman langsung di bidang infrastruktur IT.',
	},
	{
		num: '03',
		title: 'Garansi & Purna Jual',
		desc: 'Garansi produk resmi, perawatan terjadwal, dan SLA yang jelas untuk ketenangan operasional Anda.',
	},
	{
		num: '04',
		title: 'Pengadaan Transparan',
		desc: 'Harga jujur dengan sumber distributor resmi — tanpa produk gray market, selamanya.',
	},
	{
		num: '05',
		title: 'Dukungan Perawatan',
		desc: 'Dukungan teknis berkelanjutan dan pemeriksaan kesehatan sistem berkala, baik kontrak maupun on-demand.',
	},
	{
		num: '06',
		title: 'Dokumentasi Proyek',
		desc: 'Dokumentasi proyek lengkap meliputi diagram jaringan, catatan konfigurasi, dan kartu garansi.',
	},
];
---

<section id="keunggulan" class="bg-white py-16 lg:py-24">
	<div class="max-w-[1280px] mx-auto px-6 lg:px-10">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
			<div class="lg:col-span-4">
				<p class="text-meta text-teal mb-4">KENAPA CHILVA</p>
				<h2 class="text-display-sm text-ink">Dibangun atas Kepercayaan</h2>
				<p class="mt-5 text-body-lg text-mute leading-relaxed max-w-sm">
					Kami menggabungkan perangkat keras berkualitas, instalasi profesional, dan dukungan berkelanjutan dalam satu layanan terintegrasi.
				</p>
			</div>

			<div class="lg:col-span-8">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-border">
					{reasons.map((item) => (
						<div class="py-7 sm:px-8 first:sm:pl-0 last:sm:pr-0 group">
							<span class="text-[12px] font-semibold text-teal tabular-nums">{item.num}</span>
							<h3 class="mt-2 text-[16px] font-semibold text-ink">{item.title}</h3>
							<p class="mt-2 text-[14px] text-mute leading-relaxed">{item.desc}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
